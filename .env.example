# Server-only Phase 2 configuration. Never prefix the API key with NEXT_PUBLIC_.
OPENAI_API_KEY=replace-with-a-server-only-api-key
OPENAI_MODEL=gpt-5.6
DEMO_ACCESS_CODE=

# Supabase public application configuration. These values are safe to expose to the browser
# when Row Level Security and table grants remain correctly configured.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
